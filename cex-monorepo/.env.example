NODE_ENV=development
DATABASE_URL=postgresql://cex_user:cex_dev_pw@localhost:5432/cex_db
REDIS_URL=redis://:cex_dev_redis@localhost:6379
JWT_ACCESS_SECRET=replace-with-a-random-64-character-development-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-64-character-development-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
CORS_ORIGINS=http://localhost:3000
API_PORT=4000
WS_PORT=8080
MAX_QUEUE_LEN=50000
ENGINE_DATA_DIR=./data/engine
ENGINE_FSYNC_MS=50
SNAPSHOT_EVERY_N=100000
SEED_FROM_DB=true
ENGINE_ASSERT=false
DEV_DEPOSIT_MAX=100000000000
SEED_ADMIN_PASSWORD=replace-with-a-local-development-password
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
LOG_LEVEL=info
